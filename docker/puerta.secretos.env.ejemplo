# puerta.secretos.env — SOLO el proxy lo lee. Copiar a puerta.secretos.env y rellenar.
# Permisos 600. No entra al repositorio (docker/.gitignore).

# El client_secret de la aplicacion en Auth0.
OAUTH2_PROXY_CLIENT_SECRET=EL_CLIENT_SECRET

# 32 bytes aleatorios en base64 url-safe. Generar con:
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=GENERAR_UNO
