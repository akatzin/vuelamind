# puerta.env — lo que pueden saber LOS DOS contenedores. Copiar a puerta.env y rellenar.
# NO es YAML: una clave, un igual, un valor, sin comillas ni espacios alrededor del igual.
# Los secretos NO van aqui: van en puerta.secretos.env (solo los lee el proxy).

# El origen publico, tal cual lo escribe el navegador. Tiene que ser https.
BRIDGE_PUBLIC_ORIGIN=https://agente.ejemplo.com

# --- Auth0 ---------------------------------------------------------------------------
# Dominio del tenant. Auth0 emite el `iss` CON barra final; el puente compara exacto.
OAUTH2_PROXY_OIDC_ISSUER_URL=https://TU-TENANT.us.auth0.com/
BRIDGE_IAP_ISSUER=https://TU-TENANT.us.auth0.com/
BRIDGE_IAP_JWKS_URL=https://TU-TENANT.us.auth0.com/.well-known/jwks.json

# client_id de la aplicacion (tipo «Regular Web Application»). Es el `aud` del ID token,
# y por eso es tambien la audiencia que el puente exige.
OAUTH2_PROXY_CLIENT_ID=EL_CLIENT_ID
BRIDGE_IAP_AUDIENCE=EL_CLIENT_ID

# Adonde vuelve Auth0 despues del login. Tiene que estar en «Allowed Callback URLs» de la
# aplicacion, tal cual.
OAUTH2_PROXY_REDIRECT_URL=https://agente.ejemplo.com/oauth2/callback

# --- De quien es este contenedor ------------------------------------------------------
# Un contenedor por persona: el puente solo deja pasar estos correos, aunque Auth0 haya
# autenticado a otro con exito. Lista separada por comas.
BRIDGE_IAP_EMAILS=persona@ejemplo.com
